# ══════════════════════════════════════════════
# 日常使用（员工必填）
# ══════════════════════════════════════════════

# AWS 区域
AWS_REGION=us-west-2

# AWS credentials profile（本地 ~/.aws/credentials 里的 profile 名）
AWS_PROFILE=default

# Harness ARN（由运维人员提供，运行 create_harness.py 后获得）
HARNESS_ARN=arn:aws:bedrock-agentcore:us-west-2:ACCOUNT_ID:harness/HARNESS_ID


# ══════════════════════════════════════════════
# 运维配置（仅创建资源时需要，运行后可删除）
# ══════════════════════════════════════════════

# IAM 执行角色 ARN（运行 create_harness.py 时需要）
# 创建完 Harness 后可以注释掉，hare 运行时不读取
EXECUTION_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/hare-harness-execution-role
